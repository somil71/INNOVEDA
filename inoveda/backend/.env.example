APP_NAME=INOVEDA API
APP_VERSION=0.2.0
ENVIRONMENT=production

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inoveda
# For Docker Compose: postgresql://postgres:postgres@db:5432/inoveda
# For Neon/Supabase: postgresql://user:password@host/dbname?sslmode=require

# Redis (optional — rate limiting and WebSocket pub/sub)
REDIS_URL=redis://localhost:6379/0
# For Docker Compose: redis://redis:6379/0
# For Upstash: rediss://default:token@host:6380

# Auth — CHANGE THIS IN PRODUCTION
JWT_SECRET=replace_me_with_32_random_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI (optional)
USE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:5173"]

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Rate limiting
RATE_LIMIT_PER_MINUTE=120

# Outbreak detection
OUTBREAK_METHOD=zscore
OUTBREAK_WEEKS_HISTORY=4
OUTBREAK_Z_THRESHOLD=2.0
OUTBREAK_P_THRESHOLD=0.05
OUTBREAK_MIN_CASES=3
MODEL_PATH=ml/triage_model.joblib

# AWS S3 (optional file storage)
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# AWS Secrets Manager (optional — overrides above env vars at startup)
USE_AWS_SECRETS=false
AWS_SECRET_NAME=

